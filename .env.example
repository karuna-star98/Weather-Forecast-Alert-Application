# Copy this file to ".env" and fill in your own values.  NEVER commit ".env".
# Open-Meteo needs NO API key. Optional keys below are only for notifications.

# "live" = real Open-Meteo API, "simulate" = offline sample data
WEATHER_MODE=simulate

# Optional: Telegram alerts (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Email alerts (Gmail: use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional: alert threshold overrides
THRESH_HEAT_C=40
THRESH_RAIN_PROB=60
THRESH_WIND_GUST_MS=15
